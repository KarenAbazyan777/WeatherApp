# Copy this file to .env and fill in your own values.

# Port the API listens on (Render sets it automatically)
PORT=5000

# MongoDB connection string (MongoDB Atlas or a local MongoDB)
DB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Secret used to sign login tokens: any long random text
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me

# Frontend address(es), comma separated. The first one is used in email links.
CLIENT_URL=http://localhost:3000

# Set to 1 when running behind a hosting proxy (Render, Railway, Heroku...)
# TRUST_PROXY=1

# ---- Email (optional) ----------------------------------------------------
# Without any of these, confirmation and reset links are printed to the console.

# Option A: Brevo HTTP API (works on hosts that block SMTP, e.g. Render free plan)
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=Weather App <you@example.com>

# Option B: SMTP, e.g. Gmail with an App password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-letter-app-password
# SMTP_FROM=Weather App <you@gmail.com>
