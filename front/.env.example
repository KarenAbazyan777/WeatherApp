# Copy this file to .env and fill in your own values.
# Restart `npm start` after changing it.

# Backend API address (ends with /auth)
REACT_APP_API_URL=http://localhost:5000/auth

# Free API keys from the weather providers:
#   OpenWeatherMap  https://home.openweathermap.org/api_keys
#   WeatherAPI      https://www.weatherapi.com/my/
#   Visual Crossing https://www.visualcrossing.com/account
REACT_APP_OPENWEATHER_KEY=
REACT_APP_WEATHERAPI_KEY=
REACT_APP_VISUALCROSSING_KEY=
